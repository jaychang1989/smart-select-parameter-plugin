<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:l="/lib/layout">
  <st:adjunct includes="io.jenkins.plugins.smartselect.smart-select" />
  <j:set var="smartSelectView" value="${it.view}" />
  <j:set var="escapeEntryTitleAndDescription" value="false" />
  <f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
    <div name="parameter" class="smart-select-parameter" data-mode="${it.mode}" data-remote="${it.remote}" data-error="${smartSelectView.error}" data-depends-on="${it.dependsOn}"
      data-i18n-placeholder="${%Placeholder}" data-i18n-options-label="${%OptionsLabel}" data-i18n-parameter="${%Parameter}" data-i18n-page-info="${%PageInfo}" data-i18n-selected="${%Selected}" data-i18n-count="${%Count}" data-i18n-label-separator="${%LabelSeparator}" data-i18n-waiting="${%Waiting}" data-i18n-loading="${%Loading}" data-i18n-timeout="${%Timeout}" data-i18n-unavailable="${%Unavailable}">
      <input type="hidden" name="name" value="${it.name}" />
      <input type="hidden" name="value" class="smart-select-value" value="${smartSelectView.defaultValue}" />
      <div class="smart-select-widget">
        <button type="button" class="jenkins-input smart-select-trigger" aria-haspopup="listbox" aria-expanded="false">
          <span class="smart-select-summary">${%Placeholder}</span>
          <span class="smart-select-chevron" aria-hidden="true"><l:icon src="symbol-chevron-down" class="icon-sm" /></span>
        </button>
        <div class="smart-select-popup" hidden="hidden">
          <j:if test="${it.searchable}">
            <div class="smart-select-search-wrap">
              <input type="search" class="jenkins-input smart-select-search" placeholder="${%SearchPlaceholder}" aria-label="${%SearchLabel}" autocomplete="off" />
            </div>
          </j:if>
          <j:if test="${it.multi}">
            <div class="smart-select-toolbar">
              <span class="smart-select-count"></span>
              <div>
                <button type="button" class="smart-select-select-all">${%SelectAll}</button>
                <button type="button" class="smart-select-clear">${%Clear}</button>
              </div>
            </div>
          </j:if>
          <div class="smart-select-options" role="listbox" aria-multiselectable="${it.multi}">
            <j:choose>
            <j:when test="${smartSelectView.options.size() &gt; 100}">
              <input type="hidden" class="smart-select-data" value="${smartSelectView.optionsJson}" />
            </j:when>
            <j:otherwise>
            <j:forEach var="choice" items="${smartSelectView.options}">
              <button type="button" class="smart-select-option" role="option" data-value="${choice.value}" aria-selected="${smartSelectView.isSelected(choice.value)}">
                <span class="smart-select-indicator" aria-hidden="true"></span>
                <span class="smart-select-label">${choice.label}</span>
              </button>
            </j:forEach>
            </j:otherwise>
            </j:choose>
          </div>
          <div class="smart-select-pagination" hidden="hidden">
            <button type="button" class="smart-select-previous">${%Previous}</button>
            <span class="smart-select-page-info" aria-live="polite"></span>
            <button type="button" class="smart-select-next">${%Next}</button>
          </div>
          <div class="smart-select-empty" hidden="hidden">${%Empty}</div>
        </div>
      </div>
      <div class="smart-select-error" role="status" aria-live="polite">${smartSelectView.error}</div>
      <j:if test="${it.remote}">
        <button type="button" class="smart-select-refresh">${%Refresh}</button>
      </j:if>
    </div>
  </f:entry>
</j:jelly>
