<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Name}">
    <f:textbox name="parameter.name" value="${instance.name}" />
  </f:entry>
  <f:entry title="${%Mode}">
    <div class="jenkins-select">
    <select name="parameter.mode" class="jenkins-select__input">
      <j:choose>
        <j:when test="${instance!=null &amp;&amp; instance.mode=='SINGLE'}">
          <option value="MULTI">${%Multi}</option>
          <option value="SINGLE" selected="selected">${%Single}</option>
        </j:when>
        <j:otherwise>
          <option value="MULTI" selected="selected">${%Multi}</option>
          <option value="SINGLE">${%Single}</option>
        </j:otherwise>
      </j:choose>
    </select>
    </div>
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/choices.html" title="${%Choices}" description="${%ChoicesHelp}">
    <f:textarea checkMethod="post" name="parameter.choices" value="${instance.choicesText}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/defaultValues.html" title="${%DefaultValues}" description="${%DefaultsHelp}">
    <f:textbox name="parameter.defaultValues" value="${instance.defaultValuesText}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/options.html" title="${%Options}" description="${%OptionsHelp}">
    <f:textarea name="parameter.options" value="${instance.optionsText}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/restUrl.html" title="${%RestUrl}" description="${%RestUrlHelp}">
    <f:textbox name="parameter.restUrl" value="${instance.restUrl}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/restItemsPath.html" title="${%ItemsPath}" description="${%ItemsPathHelp}">
    <f:textbox name="parameter.restItemsPath" value="${instance.restItemsPath}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/dependsOn.html" title="${%DependsOn}" description="${%DependsOnHelp}">
    <f:textbox name="parameter.dependsOn" value="${instance.dependsOn}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/restToken.html" title="${%Token}" description="${%TokenHelp}">
    <f:password name="parameter.restToken" value="${instance.restToken}" />
  </f:entry>
  <f:entry help="${rootURL}/plugin/smart-select-parameter/help/cacheSeconds.html" title="${%CacheSeconds}" description="${%CacheHelp}">
    <f:number name="parameter.cacheSeconds" value="${instance.cacheSeconds}" default="30" min="0" max="300" />
  </f:entry>
  <f:entry title="${%Searchable}">
    <f:checkbox name="parameter.searchable" checked="${instance==null || instance.searchable}" />
  </f:entry>
  <f:entry title="${%Description}">
    <f:textarea name="parameter.description" value="${instance.description}" />
  </f:entry>
</j:jelly>
