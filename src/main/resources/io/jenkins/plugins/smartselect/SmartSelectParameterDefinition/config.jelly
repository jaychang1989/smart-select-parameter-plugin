<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Name}">
    <f:textbox name="parameter.name" value="${instance.name}" />
  </f:entry>
  <f:entry title="${%Mode}">
    <select name="parameter.mode" class="jenkins-select__input">
      <j:choose>
        <j:when test="${instance!=null &amp;&amp; instance.mode=='SINGLE'}">
          <option value="MULTI">多选 (MULTI)</option>
          <option value="SINGLE" selected="selected">单选 (SINGLE)</option>
        </j:when>
        <j:otherwise>
          <option value="MULTI" selected="selected">多选 (MULTI)</option>
          <option value="SINGLE">单选 (SINGLE)</option>
        </j:otherwise>
      </j:choose>
    </select>
  </f:entry>
  <f:entry title="${%Choices}" description="每行一个选项；在 Jenkinsfile 中也可使用字符串数组。选项不允许包含逗号。">
    <f:textarea checkMethod="post" name="parameter.choices" value="${instance.choicesText}" />
  </f:entry>
  <f:entry title="${%Default values}" description="多个默认值使用英文逗号分隔；单选时只填写一个。">
    <f:textbox name="parameter.defaultValues" value="${instance.defaultValuesText}" />
  </f:entry>
  <f:entry title="展示名称与实际值" description="可选 JSON 数组，例如 [{&quot;value&quot;:&quot;price&quot;,&quot;label&quot;:&quot;报价服务&quot;}]。填写后替代上方普通选项。">
    <f:textarea name="parameter.options" value="${instance.optionsText}" />
  </f:entry>
  <f:entry title="REST 选项地址" description="可选。填写后使用接口数据代替静态选项。接口必须返回 JSON 数组，且来源地址须在系统配置中获管理员授权。">
    <f:textbox name="parameter.restUrl" value="${instance.restUrl}" />
  </f:entry>
  <f:entry title="JSON 数组路径" description="根数组留空；对象中的数组可填写 data.items 等点分路径。">
    <f:textbox name="parameter.restItemsPath" value="${instance.restItemsPath}" />
  </f:entry>
  <f:entry title="依赖的上级参数" description="可选，多个名称用英文逗号分隔。REST 地址仅在问号后的查询值中填写对应占位符，详见 README 的联动示例。上级变化时会清空旧选择并重新读取。">
    <f:textbox name="parameter.dependsOn" value="${instance.dependsOn}" />
  </f:entry>
  <f:entry title="Bearer 令牌" description="可选；由 Jenkins 加密保存，不会发送到构建参数页面。">
    <f:password name="parameter.restToken" value="${instance.restToken}" />
  </f:entry>
  <f:entry title="缓存秒数" description="0 到 300 秒；默认 30 秒。数据源失败时拒绝构建，不回退到静态选项。">
    <f:number name="parameter.cacheSeconds" value="${instance==null ? 30 : instance.cacheSeconds}" min="0" max="300" />
  </f:entry>
  <f:entry title="${%Enable search}">
    <f:checkbox name="parameter.searchable" checked="${instance==null || instance.searchable}" />
  </f:entry>
  <f:entry title="${%Description}">
    <f:textarea name="parameter.description" value="${instance.description}" />
  </f:entry>
</j:jelly>
